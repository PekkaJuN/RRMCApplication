# RRMCApplication settings. Copy this file to .env and change values there.
# Docker Compose and the backend both read .env. Never commit .env.
# A setting left out uses the default shown here.

# Folders on this computer. They are mounted into the backend container as
# /data/import, /data/import_done and /data/import_failed.
# Incoming receipt images:
RRMC_IMPORT_DIR=./source/import
# Images whose data is saved in the database:
RRMC_DONE_DIR=./source/import_done
# Images that could not be imported:
RRMC_FAILED_DIR=./source/import_failed

# Model evaluation: receipt images and truth files on this computer, mounted into the
# eval service as /data/eval. Results are written under it and never leave this computer.
RRMC_EVAL_DIR=./source/eval

# real = Tesseract and Ollama; fake = deterministic fakes for tests.
RRMC_ENGINES=real

# Ollama address as seen from the backend container. Ollama runs on this computer.
RRMC_OLLAMA_URL=http://host.docker.internal:11434

# Ollama model name. Pull it first: ollama pull <name>
# Chosen by model evaluation (docs/adr/0003-receipt-reading-model.md).
RRMC_MODEL=qwen3:30b-a3b-instruct-2507-q4_K_M

# Log level: DEBUG, INFO, WARNING or ERROR.
RRMC_LOG_LEVEL=INFO

# Ports on 127.0.0.1 for the backend and the UI.
RRMC_BACKEND_PORT=8000
RRMC_UI_PORT=5173
